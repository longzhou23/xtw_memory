#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
if [ -n "${XTW_MEMORY_PYTHON:-}" ]; then
    python=$XTW_MEMORY_PYTHON
elif [ -x "$root/.venv/bin/python" ]; then
    python=$root/.venv/bin/python
else
    python=python3
fi
exec "$python" "$root/research-mvp/scripts/chat_gateway.py" "$@"
